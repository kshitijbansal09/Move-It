# C++ web application only. The Express backend's .env is not read.
HOST=127.0.0.1
PORT=5002
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=moveit_cpp
# Optional local socket, e.g. /tmp/mysql.sock
DB_SOCKET_PATH=
# Set a random secret of at least 32 characters for sessions that survive restarts.
# If omitted, a cryptographically random key is generated at startup.
# JWT_SECRET=
LOW_DEMAND_THRESHOLD=5
STATIC_DIR=frontend/dist
SCHEMA_FILE=sql/schema.sql
