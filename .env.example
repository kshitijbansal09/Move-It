# C++ web application only. The Express backend's .env is not read.
HOST=127.0.0.1
PORT=5002
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=moveit_cpp
# Optional local socket, e.g. /tmp/mysql.sock
DB_SOCKET_PATH=
# Set a random secret of at least 32 characters for sessions that survive restarts.
# If omitted, a cryptographically random key is generated at startup.
# JWT_SECRET=
HIGH_DEMAND_THRESHOLD=5
AWAITING_CHOICE_TTL_MINUTES=30

# Optional Twilio WhatsApp Sandbox updates
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional approved template for each alert, including Twilio trial testing.
# TWILIO_WHATSAPP_CONTENT_SID=
# Approved Move It template with booking ID as {{1}} and ride update as {{2}}.
# TWILIO_WHATSAPP_RIDE_CONTENT_SID=
# WHATSAPP_ENABLED=0
# WHATSAPP_SIMULATE=1
STATIC_DIR=frontend/dist
SCHEMA_FILE=sql/schema.sql
